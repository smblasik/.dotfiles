-- Hyprland default apps

TERMINAL     = "kitty"
FILE_MANAGER = "thunar"
BROWSER      = "zen-browser"
EDITOR       = "gnome-text-editor --new-window"
CALCULATOR   = "gnome-calculator"

-- Monitors
-- Defaults come from .chezmoidata.toml; override per machine in ~/.config/chezmoi/chezmoi.toml
MONITOR1 = "{{ .monitors.MONITOR1 | default "eDP-1" }}"
MONITOR2 = "{{ .monitors.MONITOR2 | default "DP-1" }}"
MONITOR3 = "{{ .monitors.MONITOR3 | default "" }}"
PRIMARY_MONITOR = MONITOR1

-- Workspaces
NUM_WPM = 5 -- Number of workspaces per monitor (Max 10)
